VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
VITE_API_BASE_URL=http://localhost:4000
# Log every API call to the browser console (on by default in dev)
VITE_DEBUG_API=true

# Patient Similarity Model Feature Flags
VITE_PATIENT_SIMILARITY_ENABLED=true
VITE_PATIENT_SIMILARITY_USE_SYNTHETIC_DATA=true

# Show the in-app assistant button (also needs ASSISTANT_ENABLED=true on the server)
VITE_ASSISTANT_ENABLED=false
# Tab-only memory; keep these build-time limits aligned with the server settings.
VITE_ASSISTANT_MEMORY_ITEMS=10
VITE_ASSISTANT_MEMORY_MAX_AGE_MIN=120
