PORT=4000
NODE_ENV=development
SUPABASE_URL=https://your-supabase-project-id.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
CLIENT_APP_URL=http://localhost:5173
OCR_SERVICE_URL=http://localhost:8000
# How long an upload waits for extraction (ms). Scans take ~10s a page on CPU.
OCR_TIMEOUT_MS=180000
# Shortest word in a report's patient name where a one-letter difference counts as an OCR misread.
OCR_NAME_TYPO_MIN_LENGTH=6
# How long a scan waits in memory for the uploader to answer a name mismatch (ms), and how many may wait at once.
OCR_PENDING_EXTRACTION_TTL_MS=600000
OCR_PENDING_EXTRACTION_MAX=100

# SMTP Configuration for Invite Emails
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-smtp-user
SMTP_PASS=your-smtp-password
SMTP_FROM=no-reply@example.com

INVITE_TOKEN_TTL_HOURS=72
OCR_CONFIDENCE_REVIEW_THRESHOLD=0.85

# Logging: debug | info | warn | error | silent (default: debug in development, info otherwise)
LOG_LEVEL=debug
# pretty (human-readable) | json (one object per line, for log shippers)
LOG_FORMAT=pretty

# Demo only: clinicians can verify their own account from the
# verification-pending page. Set to false before real use.
DEMO_SELF_VERIFY=true

# Consultation Audio Pipeline
SESSION_TOKEN_SECRET=replace-with-a-secure-random-secret
SESSION_TOKEN_TTL_SEC=7200
CHUNK_MIN_SEC=15
CHUNK_HARD_CAP_SEC=25
PAUSE_MS=500
SILENCE_DBFS=-45
END_DEADLINE_SEC=15
ORCHESTRATOR_POLL_MS=1000
ROOM_CODE_TTL_MIN=10
CHUNK_MAX_BYTES=2000000
TRANSCRIBE_CONCURRENCY=3
TRANSCRIBE_MAX_ATTEMPTS=3
STT_PROVIDER=sarvam
SARVAM_API_KEY=your-sarvam-api-key
WHISPER_SERVICE_URL=http://localhost:8001
# 'auto' or a language code such as en / hi
STT_DEFAULT_LANGUAGE=auto
# Whisper service guards (read by whisper-service/main.py)
WHISPER_ALLOWED_LANGUAGES=en,hi
WHISPER_NO_SPEECH_THRESHOLD=0.6
WHISPER_LOG_PROB_THRESHOLD=-1.0
WHISPER_COMPRESSION_RATIO_THRESHOLD=2.4
WHISPER_VAD_THRESHOLD=0.6
GEMINI_API_KEY=your-gemini-api-key
DEDUPE_MIN_OVERLAP=0.5
DEDUPE_MIN_SIMILARITY=0.8
LOW_CONFIDENCE_THRESHOLD=0.65
NOISE_CONFIDENCE_FLOOR=0.25
CROSSTALK_PARTIAL_SIMILARITY=0.25
CROSSTALK_PARTIAL_LOUDNESS_DB=6
CROSSTALK_DOMINANT_LOUDNESS_DB=10

# Clinical Notes Drafting (Phase 8)
# DRAFT_MODEL_PROVIDER: 'gemini' | 'local' | 'fake'
DRAFT_MODEL_PROVIDER=gemini
GEMINI_DRAFT_MODEL=gemini-1.5-flash
LOCAL_LLM_URL=http://localhost:11434/api/chat
LOCAL_LLM_MODEL=qwen3:8b
LOCAL_LLM_THINK=false
DRAFT_TIMEOUT_MS=25000


# In-app assistant (opens pages and records, fills forms). Off unless true.
ASSISTANT_ENABLED=false
# Server-owned multi-round routing; clients cannot enable it.
ASSISTANT_AGENT_LOOP=true
# Optional shared signing key; unset uses a process-local key (restart expires continuations).
ASSISTANT_CONTINUATION_SECRET=
# Phase 3: let it press buttons that save or send (always after the user confirms on a card).
# Off: it fills the form and the user presses the button.
ASSISTANT_ACTIONS_ENABLED=false
# ollama (local, native API) | gemini (Google; key in GEMINI_API_KEY or LLM_API_KEY) | openai-compatible (hosted or vLLM) | fake (tests)
# Hosted models receive what doctors type (names, clinical values): use one only with a data agreement in place.
LLM_PROVIDER=ollama
LLM_BASE_URL=http://127.0.0.1:11434
LLM_API_KEY=
LLM_MODEL=gemma4:e4b
# Optional planner model: Gemini Flash plans, Flash Lite navigates; empty uses main model.
LLM_PLANNER_MODEL=
# With LLM_PROVIDER=gemini: LLM_MODEL=gemini-flash-lite-latest (default) or gemini-flash-latest.
# Gemini only: second model tried once when the first is busy (empty = off), and thinking level (low | high | empty = default).
LLM_FALLBACK_MODEL=
LLM_THINKING_LEVEL=
# Ollama only: keep the model loaded between requests, and its context size (form controls need ~4k).
LLM_KEEP_ALIVE=15m
LLM_NUM_CTX=8192
# Cap on the model's reply (~30 tokens per step, ~15 per filled field) and most steps per request.
# Leave unset for Gemini (default 2048, since its thinking counts against the cap).
LLM_MAX_OUTPUT_TOKENS=512
ASSISTANT_MAX_STEPS=4
ASSISTANT_TIMEOUT_MS=15000
ASSISTANT_COLD_START_TIMEOUT_MS=90000
ASSISTANT_WARM_WINDOW_MS=600000
ASSISTANT_MAX_MESSAGE_CHARS=600
# One request can take several read-and-act rounds, each counted here.
ASSISTANT_RATE_LIMIT_PER_MINUTE=60
# Phase 5 page reading (doctors): most labels sent per page, actions per round, rounds per request,
# and the length of an app-help answer.
ASSISTANT_MAX_PAGE_ELEMENTS=120
ASSISTANT_MAX_PAGE_ACTIONS=8
ASSISTANT_MAX_ROUNDS=15
ASSISTANT_MAX_PAGE_VISITS=3
ASSISTANT_MAX_ACTION_REPEATS=2
ASSISTANT_REQUEST_TIMEOUT_MS=180000
ASSISTANT_MODEL_TIMEOUT_MS=30000
ASSISTANT_CONTINUATION_MAX_CHARS=32000
ASSISTANT_STALL_LIMIT=2
ASSISTANT_SETTLE_QUIET_MS=300
ASSISTANT_SETTLE_TIMEOUT_MS=3000
ASSISTANT_SNAPSHOT_TOKEN_BUDGET=1500
ASSISTANT_MAX_ANSWER_CHARS=300
# Phase 2b: furthest ahead the assistant may fill an appointment date, and the
# zone used when the browser sends none (IANA name).
ASSISTANT_MAX_BOOKING_DAYS=365
ASSISTANT_DEFAULT_TIMEZONE=Asia/Kolkata
# Optional overrides for the fixed replies. Any health-related wording needs clinician sign-off.
# ASSISTANT_UNSUPPORTED_MESSAGE=
# ASSISTANT_UNAVAILABLE_MESSAGE=

# Optional server-side audio cache; Supabase remains persistent storage.
# Start locally: docker compose -f docker-compose.redis.yml up -d
CONSULT_AUDIO_CACHE_ENABLED=false
REDIS_URL=redis://127.0.0.1:6379
AUDIO_CACHE_TTL_SEC=1800
REDIS_CONNECT_TIMEOUT_MS=500
REDIS_COMMAND_TIMEOUT_MS=200
REDIS_RECONNECT_MAX_DELAY_MS=5000
REDIS_MAX_PENDING_COMMANDS=128
REDIS_MAXMEMORY_MB=256
# Compose publishes Redis on loopback only. Match REDIS_URL if this changes.
REDIS_PORT=6379
